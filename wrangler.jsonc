{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aa-benchmark",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/icons/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "aa-benchmark-db",
    "database_id": "4c4165a4-7de6-482d-aff3-1f84d28151ec",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "ICONS", "bucket_name": "aa-benchmark-icons" }]
}
