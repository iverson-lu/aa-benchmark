{
  "name": "aa-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --port 8787",
    "build": "vite build",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test:smoke": "node scripts/smoke.mjs",
    "deploy": "npm run check && npm run build && wrangler deploy",
    "data:extract": "node scripts/extract.mjs",
    "setup:local": "node scripts/setup.mjs local",
    "data:remote": "node scripts/setup.mjs remote --data-only",
    "assets:remote": "node scripts/setup.mjs remote --assets-only"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261007.1",
    "cheerio": "1.2.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "wrangler": "4.148.0"
  },
  "overrides": { "sharp": "0.35.5" }
}
